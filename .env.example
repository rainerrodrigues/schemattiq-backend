# ===== Render Workflow (workflows_worker.py) =====
# --- AgenticOrg ---
AGENTICORG_API_KEY=ao_sk_...
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# Required when agents are referenced by name rather than UUID
AGENTICORG_COMPANY_ID=
ROHAN_AGENT_ID=Rohan_Firmware_Lead
MEERA_AGENT_ID=Meera_BOM_Buyer
BOM_MERCHANT_ID=schemattiq_india_bom
# Times an over-budget cart goes back to Meera for cheaper swaps before HITL
MAX_REQUOTES=1

# --- Greptile ---
GREPTILE_API_KEY=
GITHUB_TOKEN=
# /v2/query was retired; set these once Greptile's current query path is known
GREPTILE_BASE_URL=https://api.greptile.com/v2
GREPTILE_QUERY_PATH=/query

# --- Render (both services) ---
RENDER_API_KEY=
# Workspace (owner) ID, e.g. tea-xxxx; required for Sandboxes
RENDER_WORKSPACE_ID=

# ===== Web service (api.py) =====
PIPELINE_TASK_SLUG=schemattiq-workflow/schemattiq_pipeline
CORS_ORIGINS=*
# Public URL of this web service; Vobiz calls its /vobiz/* webhooks
PUBLIC_BASE_URL=https://schemattiq-api.onrender.com
# SQLite session log; use a Render persistent disk path so it survives deploys
DB_PATH=/var/data/schemattiq.db

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Vobiz ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Your Vobiz Indian DID, e.g. 918012345678
VOBIZ_FROM_NUMBER=
# Over-budget BOMs above this total also get a live approval call
VOBIZ_CALL_THRESHOLD_INR=5000

# --- Pine Labs ---
# Shown on the BOM tab once Grantex approves
PINELABS_CHECKOUT_URL=
